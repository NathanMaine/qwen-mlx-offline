#!/usr/bin/env bash
# Qwen Code against the LOCAL 4-bit model. Nothing leaves this laptop.
#   ~54 tok/s, 15.5 GB resident. Faster; expect some quality loss on hard
#   reasoning and long code versus 8-bit.
# Extra args pass through, e.g. qwen-local-4 -p "review this".
set -euo pipefail

MODEL="$HOME/models/Qwen3.8-27B-4bit"
[ -d "$MODEL" ] || { echo "qwen: 4-bit model not found at $MODEL" >&2; exit 1; }

# Swaps the server to 4-bit if it is currently holding a different quant.
qwen-serve start 4

printf '\033[32m● LOCAL 4-bit\033[0m  ~54 tok/s, 15.5 GB  (127.0.0.1:8080, offline)\n\n'
exec qwen -m "$MODEL" "$@"
